{
  "name": "lab04",
  "version": "1.0.0",
  "description": "Room Booking API - architektura i reguły biznesowe",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "seed:run": "knex seed:run",
    "double-booking": "node scripts/double-booking.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --runInBand tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --runInBand tests/integration",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
